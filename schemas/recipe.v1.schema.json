{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hexuria/gpui-agent/main/schemas/recipe.v1.schema.json",
  "title": "gpui-agent recipe, format v1",
  "description": "Structure of a recipe file. `gpui-agent recipe validate` additionally checks ids, needs, params, and invoke args against the app schema. See docs/RECIPES.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "v": {
      "const": 1,
      "description": "Recipe format version. Defaults to 1."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "description": "A required string param."
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "type": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "bool",
                  "boolean"
                ],
                "description": "Defaults to string."
              },
              "required": {
                "type": "boolean",
                "description": "Defaults to true, or false when `default` is set."
              },
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "enum": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              },
              "pattern": {
                "type": "string",
                "description": "Regular expression the value must match. String params only."
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Params bound by --set: bare names or typed entries. Each must be used as $name or ${name} in a step."
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "name",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "oneOf": [
        {
          "title": "hello",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Unique step id. Never contains $params."
            },
            "needs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true,
              "description": "Ids of steps that must finish first."
            },
            "screenshot": {
              "type": "boolean",
              "description": "Capture an app-surface PNG after this step when the run has a screenshot dir."
            },
            "op": {
              "const": "hello"
            }
          },
          "required": [
            "id",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "title": "snapshot",
